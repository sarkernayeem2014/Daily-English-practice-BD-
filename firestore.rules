rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny All by default: Block public access to any unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. User Profile: /users/{userId}
    // Stores: uid, email, displayName, photoURL, createdAt, updatedAt
    match /users/{userId} {
      // Each signed-in user can only read their own profile
      allow get: if isOwner(userId);
      // Disallow listing/enumerating users
      allow list: if false;
      // Each signed-in user can only create or update their own profile
      allow create, update: if isOwner(userId) && (
        !('uid' in request.resource.data) || request.resource.data.uid == userId
      );
      // Disallow document deletion from client
      allow delete: if false;

      // 2. User Progress & Gamification: /users/{userId}/progress/{docId}
      // Stores: XP, streakCount, personalBestStreak, unlockedTiers, correctIds,
      // attemptedIds, struggleIds, bookmarkedIds, awardedXpIds, earnedBadges,
      // completedDailyDates, todayDailyAnswers, userAnswers, settings, etc.
      match /progress/{docId} {
        // Each signed-in user can only read and list their own progress data
        allow get, list: if isOwner(userId);
        // Each signed-in user can only save or update their own progress data
        allow create, update: if isOwner(userId) && (
          !('userId' in request.resource.data) || request.resource.data.userId == userId
        );
        // Disallow progress deletion from client
        allow delete: if false;
      }
    }
  }
}

